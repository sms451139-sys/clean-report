# Database (PostgreSQL for production)
DATABASE_URL="postgresql://user:password@host:5432/clean_report"

# JWT (Must be long, random strings in production)
JWT_SECRET="generate-a-long-random-secret-key-here"
JWT_REFRESH_SECRET="generate-another-long-random-secret-key-here"
JWT_EXPIRE="1h"
JWT_REFRESH_EXPIRE="7d"

# Server
NODE_ENV="production"
PORT=3000

# Logging
LOG_LEVEL="info"
