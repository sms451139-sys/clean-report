# Database
# For SQLite (development): file:./dev.db
# For PostgreSQL (production): postgresql://user:password@host:5432/clean_report
DATABASE_URL="file:./dev.db"

# JWT (Change these in production!)
JWT_SECRET="your-secret-key-here-change-in-production"
JWT_REFRESH_SECRET="your-refresh-secret-key-here-change-in-production"
JWT_EXPIRE="1h"
JWT_REFRESH_EXPIRE="7d"

# Server
NODE_ENV="development"
PORT=3000

# Logging
LOG_LEVEL="debug"

# Vercel Blob (for photo storage)
# Get token from: https://vercel.com/account/tokens
# Only needed in production when using Vercel deployment
VERCEL_BLOB_READ_WRITE_TOKEN="your-vercel-blob-token-here"
