# Database (PostgreSQL from Railway)
DATABASE_URL="postgresql://user:password@host:port/database"

# JWT Secrets
JWT_SECRET="[GENERATE_WITH_openssl_rand_-base64_32]"
JWT_REFRESH_SECRET="[GENERATE_WITH_openssl_rand_-base64_32]"
JWT_EXPIRE="1h"
JWT_REFRESH_EXPIRE="7d"

# Server
NODE_ENV="production"
PORT=3000

# Logging
LOG_LEVEL="info"

# Vercel Blob (for photo storage)
VERCEL_BLOB_READ_WRITE_TOKEN="[FROM_VERCEL_DASHBOARD]"

# CORS (Update this to your frontend domain after deployment)
CORS_ORIGIN="https://yourdomain.com"
