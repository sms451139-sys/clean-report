// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String?
  role      String   @default("STAFF")
  phone     String?
  profilePictureUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  // Relations
  properties      Property[]
  cleaningReports CleaningReport[]
}


model Property {
  id                  String  @id @default(uuid())
  userId              String
  propertyName        String
  propertyCode        String?
  address             String?
  latitude            Decimal?
  longitude           Decimal?
  checklistTemplateId String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  deletedAt           DateTime?

  // Relations
  user               User   @relation(fields: [userId], references: [id])
  cleaningReports    CleaningReport[]
  issues             Issue[]
  inventoryItems     InventoryItem[]
  checklistTemplate  ChecklistTemplate?

  @@index([userId])
}

model CleaningReport {
  id            String  @id @default(uuid())
  userId        String
  propertyId    String
  cleaningDate  DateTime
  checkInTime   DateTime?
  checkOutTime  DateTime?
  staffName     String?
  overallStatus String  @default("NORMAL")
  reportText    String?
  reportFormat  String  @default("BOTH")
  isSubmitted   Boolean @default(false)
  submittedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  user            User   @relation(fields: [userId], references: [id])
  property        Property @relation(fields: [propertyId], references: [id])
  checklistItems  ChecklistItem[]
  photos          ReportPhoto[]
  issues          Issue[]
  inventoryItems  InventoryItem[]

  @@index([userId, propertyId])
  @@index([cleaningDate])
}


model ChecklistItem {
  id                  String  @id @default(uuid())
  checklistTemplateId String?
  reportId            String?
  title               String
  description         String?
  order               Int     @default(0)
  isCompleted         Boolean @default(false)
  location            String?
  itemName            String?
  notes               String?
  createdAt           DateTime @default(now())

  // Relations
  checklistTemplate   ChecklistTemplate? @relation(fields: [checklistTemplateId], references: [id], onDelete: Cascade)
  report              CleaningReport? @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([checklistTemplateId])
  @@index([reportId])
}

model ReportPhoto {
  id              String  @id @default(uuid())
  reportId        String
  checklistItemId String?
  photoUrl        String
  location        String?
  fileSize        Int?
  uploadedAt      DateTime @default(now())

  // Relations
  report         CleaningReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
}

model Issue {
  id          String  @id @default(uuid())
  reportId    String
  propertyId  String
  issueType   String
  description String
  severity    String @default("LIGHT")
  photoUrl    String?
  isResolved  Boolean @default(false)
  createdAt   DateTime @default(now())
  resolvedAt  DateTime?

  // Relations
  report    CleaningReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  property  Property @relation(fields: [propertyId], references: [id])

  @@index([reportId, propertyId])
}


model InventoryItem {
  id        String  @id @default(uuid())
  reportId  String
  propertyId String
  itemName  String
  quantity  Int
  unit      String?
  createdAt DateTime @default(now())

  // Relations
  report   CleaningReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id])

  @@index([reportId, propertyId])
}

model ChecklistTemplate {
  id          String  @id @default(uuid())
  propertyId  String? @unique
  title       String
  description String?
  isDefault   Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  property  Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  items     ChecklistItem[]
}

model ReportTemplate {
  id            String  @id @default(uuid())
  templateName  String
  templateType  String
  language      String @default("JA")
  content       String
  isActive      Boolean @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

